{
  "name": "nitrorush",
  "version": "1.0.0",
  "description": "NitroRush - Production-quality 3D Multiplayer Car Racing Game built with Three.js, Rapier Physics, Socket.IO, Express, and Vanilla ES6 Modules.",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"node --watch server/index.js\" \"vite client --port 5173\"",
    "start": "node server/index.js",
    "client:dev": "vite client --port 5173",
    "server:dev": "node server/index.js",
    "build": "vite build client"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.14.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.0",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "three": "^0.165.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "vite": "^5.2.11"
  },
  "author": "Antigravity & User",
  "license": "MIT"
}
